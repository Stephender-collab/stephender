diff --git a/source/creator/CMakeLists.txt b/source/creator/CMakeLists.txt
index 985b969..7e2c453 100644
--- a/source/creator/CMakeLists.txt
+++ b/source/creator/CMakeLists.txt
@@ -1964,6 +1964,58 @@ setup_platform_linker_flags(blender)
 setup_platform_linker_libs(blender)
 setup_platform_linker_symbol_hiding(blender)
 
+# Stephender Phase 2 Fix 4: delay-load heavy rendering/denoising/shading DLLs on Windows
+# so they are not mapped into RAM at startup unless actually used.
+# Verified via PE import/export section inspection on the Windows x64 CI build:
+# - OpenImageDenoise.dll (0 data imports; defers OpenImageDenoise_core.dll ~44.8 MB).
+# - oslcomp.dll (0 data imports; ~24.6 MB), oslquery.dll (0 data imports; ~0.14 MB),
+#   oslexec.dll (0 data imports after removing OSL::Strings::* refs in cycles/scene/osl.cpp;
+#   ~46.8 MB + transitive oslnoise.dll).
+# - embree4.dll (0 data imports; ~25.8 MB + transitive sycl8.dll ~3.3 MB).
+# Excluded:
+# - usd_ms.dll: 31 imported data symbols (TfStaticData tokens, GfCamera defaults; LNK1194).
+# - openvdb.dll: eagerly imported by usd_ms.dll and initialized at startup via BKE_volumes_init().
+if(WIN32 AND MSVC AND NOT WITH_PYTHON_MODULE AND DEFINED LIBDIR)
+  set(_stephender_delayload_flags)
+  if(WITH_OPENIMAGEDENOISE AND EXISTS "${LIBDIR}/OpenImageDenoise/bin/OpenImageDenoise.dll")
+    list(APPEND _stephender_delayload_flags "/DELAYLOAD:OpenImageDenoise.dll")
+  endif()
+  if(WITH_CYCLES AND WITH_CYCLES_OSL AND EXISTS "${LIBDIR}/osl/bin/oslexec.dll")
+    if(EXISTS "${LIBDIR}/osl/bin/oslexec_d.dll")
+      list(APPEND _stephender_delayload_flags
+        "$<$<CONFIG:Debug>:/DELAYLOAD:oslcomp_d.dll>"
+        "$<$<CONFIG:Debug>:/DELAYLOAD:oslexec_d.dll>"
+        "$<$<CONFIG:Debug>:/DELAYLOAD:oslquery_d.dll>"
+        "$<$<NOT:$<CONFIG:Debug>>:/DELAYLOAD:oslcomp.dll>"
+        "$<$<NOT:$<CONFIG:Debug>>:/DELAYLOAD:oslexec.dll>"
+        "$<$<NOT:$<CONFIG:Debug>>:/DELAYLOAD:oslquery.dll>"
+      )
+    else()
+      list(APPEND _stephender_delayload_flags
+        "/DELAYLOAD:oslcomp.dll"
+        "/DELAYLOAD:oslexec.dll"
+        "/DELAYLOAD:oslquery.dll"
+      )
+    endif()
+  endif()
+  if(WITH_CYCLES AND WITH_CYCLES_EMBREE AND NOT EMBREE_STATIC_LIB AND
+     DEFINED EMBREE_MAJOR_VERSION AND EXISTS "${EMBREE_ROOT_DIR}/bin/embree${EMBREE_MAJOR_VERSION}.dll")
+    if(EXISTS "${EMBREE_ROOT_DIR}/bin/embree${EMBREE_MAJOR_VERSION}_d.dll")
+      list(APPEND _stephender_delayload_flags
+        "$<$<CONFIG:Debug>:/DELAYLOAD:embree${EMBREE_MAJOR_VERSION}_d.dll>"
+        "$<$<NOT:$<CONFIG:Debug>>:/DELAYLOAD:embree${EMBREE_MAJOR_VERSION}.dll>"
+      )
+    else()
+      list(APPEND _stephender_delayload_flags "/DELAYLOAD:embree${EMBREE_MAJOR_VERSION}.dll")
+    endif()
+  endif()
+  if(_stephender_delayload_flags)
+    target_link_libraries(blender PRIVATE delayimp.lib)
+    target_link_options(blender PRIVATE ${_stephender_delayload_flags})
+  endif()
+  unset(_stephender_delayload_flags)
+endif()
+
 blender_target_include_dirs(blender ${INC})
 
