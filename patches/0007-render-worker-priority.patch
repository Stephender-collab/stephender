+#if defined(_WIN32)
+
+ScopedLowThreadPriority::ScopedLowThreadPriority()
+{
+  const HANDLE current_thread = GetCurrentThread();
+  const int prev = GetThreadPriority(current_thread);
+  if (prev != THREAD_PRIORITY_ERROR_RETURN && prev > THREAD_PRIORITY_BELOW_NORMAL) {
+    if (SetThreadPriority(current_thread, THREAD_PRIORITY_BELOW_NORMAL) != 0) {
+      prev_priority_ = prev;
+      restore_needed_ = true;
+    }
+  }
+}
+
+ScopedLowThreadPriority::~ScopedLowThreadPriority()
+{
+  if (restore_needed_) {
+    SetThreadPriority(GetCurrentThread(), prev_priority_);
+  }
+}
+
+#elif defined(__linux__)
+
+namespace {
+constexpr int kLowPriorityNice = 10;
+}
+
+ScopedLowThreadPriority::ScopedLowThreadPriority()
+{
+  /* On Linux, PRIO_PROCESS with a kernel thread ID (from SYS_gettid) applies
+   * only to the calling thread (LWP), leaving the main/UI thread and all other
+   * threads in the process untouched. */
+  const int saved_errno = errno;
+  const long raw_tid = syscall(SYS_gettid);
+  if (raw_tid > 0) {
+    const id_t tid = static_cast<id_t>(raw_tid);
+    errno = 0;
+    const int prev = getpriority(PRIO_PROCESS, tid);
+    if (errno == 0 && prev < kLowPriorityNice) {
+      if (setpriority(PRIO_PROCESS, tid, kLowPriorityNice) == 0) {
+        prev_nice_ = prev;
+        tid_ = tid;
+        restore_needed_ = true;
+      }
+    }
+  }
+  errno = saved_errno;
+}
+
+ScopedLowThreadPriority::~ScopedLowThreadPriority()
+{
+  if (restore_needed_) {
+    const int saved_errno = errno;
+    /* Best-effort restore: succeeds if the process holds CAP_SYS_NICE or
+     * sufficient RLIMIT_NICE; silently fails with EACCES for unprivileged
+     * users, leaving only the worker threads that ran CPU rendering at
+     * kLowPriorityNice while the main/UI thread stays at normal priority. */
+    (void)setpriority(PRIO_PROCESS, tid_, prev_nice_);
+    errno = saved_errno;
+  }
+}
+
+#else
+
+ScopedLowThreadPriority::ScopedLowThreadPriority() = default;
+ScopedLowThreadPriority::~ScopedLowThreadPriority() = default;
+
+#endif
+
 CCL_NAMESPACE_END
diff --git a/intern/cycles/util/thread_priority.h b/intern/cycles/util/thread_priority.h
new file mode 100644
index 00000000..a9fe87f1
--- /dev/null
+++ b/intern/cycles/util/thread_priority.h
@@ -0,0 +1,39 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#ifdef __linux__
+#  include <sys/types.h>
+#endif
+
+CCL_NAMESPACE_BEGIN
+
+/* Scoped RAII helper that lowers the calling thread's OS scheduling priority
+ * while active (Windows: THREAD_PRIORITY_BELOW_NORMAL; Linux: per-thread nice +10)
+ * and restores the previous priority on scope exit where permitted by the OS.
+ *
+ * Only modifies the calling thread; never affects other threads (such as the
+ * main/UI thread). If the thread is already running at an equal or lower priority,
+ * leaves it unchanged. */
+class ScopedLowThreadPriority {
+ public:
+  ScopedLowThreadPriority();
+  ~ScopedLowThreadPriority();
+
+  ScopedLowThreadPriority(const ScopedLowThreadPriority &) = delete;
+  ScopedLowThreadPriority &operator=(const ScopedLowThreadPriority &) = delete;
+
+ private:
+#if defined(_WIN32)
+  int prev_priority_ = 0;
+  bool restore_needed_ = false;
+#elif defined(__linux__)
+  int prev_nice_ = 0;
+  id_t tid_ = 0;
+  bool restore_needed_ = false;
+#endif
+};
+
+CCL_NAMESPACE_END
