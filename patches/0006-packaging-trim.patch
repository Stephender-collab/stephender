diff --git a/build_files/cmake/platform/platform_unix.cmake b/build_files/cmake/platform/platform_unix.cmake
index 4719eb4..d2443c9 100644
--- a/build_files/cmake/platform/platform_unix.cmake
+++ b/build_files/cmake/platform/platform_unix.cmake
@@ -1036,6 +1036,18 @@ endif()
 
 unset(_IS_LINKER_DEFAULT)
 
+# Stephender Phase 2 Fix 5: emit per-function/per-data sections in Release/MinSizeRel
+# and garbage-collect unreferenced sections when linking `blender`.
+# Exported `Py*`/`_Py*` symbols from `symbols_unix.map` remain GC roots under
+# `-Xlinker -export-dynamic` + `-Wl,--version-script`.
+if(((CMAKE_C_COMPILER_ID STREQUAL "GNU") OR (CMAKE_C_COMPILER_ID MATCHES "Clang")) AND NOT WITH_COMPILER_ASAN)
+  string(APPEND CMAKE_C_FLAGS_RELEASE " -ffunction-sections -fdata-sections")
+  string(APPEND CMAKE_CXX_FLAGS_RELEASE " -ffunction-sections -fdata-sections")
+  string(APPEND CMAKE_C_FLAGS_MINSIZEREL " -ffunction-sections -fdata-sections")
+  string(APPEND CMAKE_CXX_FLAGS_MINSIZEREL " -ffunction-sections -fdata-sections")
+  string(APPEND PLATFORM_LINKFLAGS_RELEASE " -Wl,--gc-sections")
+endif()
+
 # Avoid conflicts with Mesa llvmpipe, Luxrender, and other plug-ins that may
 # use the same libraries as Blender with a different version or build options.
 set(PLATFORM_SYMBOLS_MAP ${CMAKE_SOURCE_DIR}/source/creator/symbols_unix.map)
diff --git a/build_files/cmake/platform/platform_win32.cmake b/build_files/cmake/platform/platform_win32.cmake
index 1ed0c53..31e7ef1 100644
--- a/build_files/cmake/platform/platform_win32.cmake
+++ b/build_files/cmake/platform/platform_win32.cmake
@@ -275,16 +275,28 @@ endif()
 if(WITH_WINDOWS_RELEASE_PDB)
   set(PDB_INFO_OVERRIDE_FLAGS "${SYMBOL_FORMAT_RELEASE}")
   set(PDB_INFO_OVERRIDE_LINKER_FLAGS "/DEBUG /OPT:REF /OPT:ICF /INCREMENTAL:NO")
+else()
+  # Ensure Release builds still dead-strip and fold COMDATs when PDB generation is disabled.
+  set(PDB_INFO_OVERRIDE_LINKER_FLAGS "/OPT:REF /OPT:ICF /INCREMENTAL:NO")
+endif()
+
+# Stephender Phase 2 Fix 5: enable function-level linking (/Gy) in Release/MinSizeRel
+# for MSVC cl.exe so /OPT:REF and /OPT:ICF can eliminate unreferenced functions and
+# fold identical COMDATs at function granularity (clang-cl already sets /Gy above).
+set(_MSVC_RELEASE_COMDAT_FLAG "")
+if(NOT MSVC_CLANG)
+  set(_MSVC_RELEASE_COMDAT_FLAG " /Gy")
 endif()
 
 string(APPEND CMAKE_CXX_FLAGS_DEBUG " /MDd ${SYMBOL_FORMAT}")
 string(APPEND CMAKE_C_FLAGS_DEBUG " /MDd ${SYMBOL_FORMAT}")
-string(APPEND CMAKE_CXX_FLAGS_RELEASE " /MD ${PDB_INFO_OVERRIDE_FLAGS}")
-string(APPEND CMAKE_C_FLAGS_RELEASE " /MD ${PDB_INFO_OVERRIDE_FLAGS}")
-string(APPEND CMAKE_CXX_FLAGS_MINSIZEREL " /MD ${PDB_INFO_OVERRIDE_FLAGS}")
-string(APPEND CMAKE_C_FLAGS_MINSIZEREL " /MD ${PDB_INFO_OVERRIDE_FLAGS}")
+string(APPEND CMAKE_CXX_FLAGS_RELEASE " /MD${_MSVC_RELEASE_COMDAT_FLAG} ${PDB_INFO_OVERRIDE_FLAGS}")
+string(APPEND CMAKE_C_FLAGS_RELEASE " /MD${_MSVC_RELEASE_COMDAT_FLAG} ${PDB_INFO_OVERRIDE_FLAGS}")
+string(APPEND CMAKE_CXX_FLAGS_MINSIZEREL " /MD${_MSVC_RELEASE_COMDAT_FLAG} ${PDB_INFO_OVERRIDE_FLAGS}")
+string(APPEND CMAKE_C_FLAGS_MINSIZEREL " /MD${_MSVC_RELEASE_COMDAT_FLAG} ${PDB_INFO_OVERRIDE_FLAGS}")
 string(APPEND CMAKE_CXX_FLAGS_RELWITHDEBINFO " /MD ${SYMBOL_FORMAT_RELEASE}")
 string(APPEND CMAKE_C_FLAGS_RELWITHDEBINFO " /MD ${SYMBOL_FORMAT_RELEASE}")
+unset(_MSVC_RELEASE_COMDAT_FLAG)
 unset(SYMBOL_FORMAT)
 unset(SYMBOL_FORMAT_RELEASE)
 
